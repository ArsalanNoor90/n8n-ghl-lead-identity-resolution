    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n  \n  // Fallback to random/timestamp key if source_record_id is not present\n  const recordId = data.source_record_id || `generated_${Date.now()}`;\n  const source_idempotency_key = `${data.source}:${recordId}`;\n\n  return {\n    json: {\n      ...data,\n      source_idempotency_key\n    }\n  };\n});"
      },
