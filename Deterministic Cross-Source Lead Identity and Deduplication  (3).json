    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const json = item.json;\n  const body = json.body || {};\n  const isVapi = json.source === \"voice_agent\" || json.source === \"vapi\";\n\n  let conversation = [];\n  let userMessages = [];\n\n  if (isVapi && json.vapi_message?.artifact?.messages) {\n    const messages = json.vapi_message.artifact.messages;\n    conversation = messages\n      .filter(m => (m.role === 'user' || m.role === 'bot') && m.message)\n      .map(m => ({\n        role: m.role === 'bot' ? 'assistant' : 'user',\n        message: m.message,\n        time: m.time || null,\n        secondsFromStart: m.secondsFromStart ?? null\n      }));\n\n    userMessages = conversation.filter(m => m.role === 'user').map(m => m.message);\n  }\n\n  return {\n    json: {\n      ...json,\n      source_record_id: body.lead?.source_record_id || body.submission_id || body.lead_id || body.call_id || body.external_id || null,\n      conversation,\n      user_messages: userMessages,\n      received_at: new Date().toISOString()\n    }\n  };\n});"
