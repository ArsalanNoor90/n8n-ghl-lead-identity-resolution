    {
      "parameters": {
        "jsCode": "const phoneMatches = $('Prepare Phone Matches').first().json.matched_ids || [];\nconst emailMatches = $('Prepare Email Matches').first().json.matched_ids || [];\nconst externalMatches = $('Prepare External-ID Matches').first().json.matched_ids || [];\n\nconst allIds = [...new Set([...phoneMatches, ...emailMatches, ...externalMatches])];\n\nreturn [{\n  json: {\n    candidate_contact_ids: allIds,\n    candidate_contact_count: allIds.length,\n    identity_decision: allIds.length > 1 ? 'manual_review' : (allIds.length === 1 ? 'update_existing' : 'create_new'),\n    selected_contact_id: allIds.length === 1 ? allIds[0] : null,\n    phone_matches: phoneMatches,\n    email_matches: emailMatches,\n    external_matches: externalMatches\n  }\n}];"
      },
