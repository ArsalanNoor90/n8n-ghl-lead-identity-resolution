    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body || {};\n  \n  // Dynamic Source Detection Logic\n  let detectedSource = body.source || \"unknown\";\n  \n  if (!body.source) {\n    if (body.call_id || body.message?.type) detectedSource = \"voice_agent\";\n    else if (body.lead_id) detectedSource = \"meta\";\n    else if (body.submission_id) detectedSource = \"website\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      source: detectedSource,\n      body: body\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1280,
        -720
      ],
      "id": "83ef62e5-54d5-4f38-b1e5-2cf291ee1c03",
      "name": "Detect Source"
    },
    {
      "parameters": {
        "jsCode": "function normalizeEmail(value) {\n  if (!value) return \"\";\n  const email = String(value).trim().toLowerCase();\n  return email.includes(\"@\") ? email : \"\";\n}\n\nfunction normalizePhone(value) {\n  if (!value) return \"\";\n  let digits = String(value).replace(/\\D/g, \"\");\n\n  if (digits.length === 10) digits = \"1\" + digits;\n  if (digits.length < 11 || digits.length > 15) return \"\";\n\n  return \"+\" + digits;\n}\n\nreturn $input.all().map(item => {\n  const data = item.json;\n  const body = data.body || {};\n  const lead = body.lead || body; // Fallback for nested or flat payloads\n\n  // Extract raw fields across different source formats\n  const rawEmail = lead.email || lead.email_address || body.email || \"\";\n  const rawPhone = lead.phone || lead.phone_number || body.phone || body.caller?.phone || \"\";\n  const rawFirstName = lead.first_name || (lead.full_name ? lead.full_name.split(' ')[0] : \"\") || \"\";\n  const rawLastName = lead.last_name || (lead.full_name ? lead.full_name.split(' ').slice(1).join(' ') : \"\") || \"\";\n\n  return {\n    json: {\n      first_name: rawFirstName || null,\n      last_name: rawLastName || null,\n      normalized_email: normalizeEmail(rawEmail) || null,\n      normalized_phone: normalizePhone(rawPhone) || null,\n      company: lead.company || body.company || null,\n      source: data.source || \"unknown\",\n      source_record_id: data.source_record_id || null,\n      received_at: data.received_at || new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        -720
      ],
      "id": "55537e7f-baf2-4a70-8b58-e33bc7ee7cc5",
      "name": "Normalize to Canonical Lead"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n\n  const hasPhone = !!data.normalized_phone;\n  const hasEmail = !!data.normalized_email;\n  const hasSourceId = !!data.source_record_id;\n\n  const identityAvailable = hasPhone || hasEmail || hasSourceId;\n\n  // Document Step 3 Enforcement: Reject if no valid identity key exists\n  if (!identityAvailable) {\n    throw new Error(`Unusable Identity Data: Lead from '${data.source}' must have at least phone, email, or trusted source record ID.`);\n  }\n\n  return {\n    json: {\n      ...data,\n      identity_available: identityAvailable,\n      identity_fields: {\n        phone: hasPhone,\n        email: hasEmail,\n        source_record_id: hasSourceId\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
