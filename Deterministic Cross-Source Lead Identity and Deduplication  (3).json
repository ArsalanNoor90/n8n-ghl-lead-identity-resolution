    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const originalItems = $('Create Source Idempotency Key').all();\n  const original = originalItems[index] ? originalItems[index].json : $('Create Source Idempotency Key').first().json;\n\n  return {\n    json: original\n  };\n});"
